# Copy to /home/perfumeapp/perfume_labels_system/.env on the VPS.
# Never commit the real .env file.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,YOUR_VPS_IP
# Leave empty until a domain and HTTPS certificate exist.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=False
